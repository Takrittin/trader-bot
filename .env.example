ALPACA_TRADING_MODE=paper
ALPACA_TRADING_BASE_URL=https://paper-api.alpaca.markets
ALPACA_DATA_BASE_URL=https://data.alpaca.markets

# Paper account credentials. These must never be prefixed with NEXT_PUBLIC_.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Set true to block all paper order submissions server-side.
ORDER_SUBMISSIONS_DISABLED=false

# Local SQLite journal path. Keep this out of Git.
BOTTRADER_JOURNAL_DB_PATH=.data/bottrader.sqlite
